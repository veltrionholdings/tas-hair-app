# Bookings Engine API URL
VITE_API_BASE_URL=http://localhost:3000/v1

# Cognito auth
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_REGION=eu-west-1
VITE_COGNITO_USER_POOL_ID=

# Google federated sign-in (Cognito Hosted UI).
# Leave VITE_COGNITO_DOMAIN empty to hide the "Continue with Google" button.
# Example: tas-hair-auth.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_DOMAIN=
# Optional: override the OAuth redirect URI (defaults to <origin>/auth/callback)
VITE_COGNITO_REDIRECT_URI=
